#
# NEVER commit .env to git. Copy this file to .env and fill values.
# All constants from φ = 1.618033988749895

# ── Core ──
NODE_ENV=production
PORT=8080

# ── Database (Neon Postgres + pgvector 384D) ──
DATABASE_URL=postgresql://user:password@your-host.neon.tech/heady?sslmode=require

# ── Redis (Upstash — T0 Memory) ──
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── Firebase Auth (27 providers) ──
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id

# ── GCP (Cloud Run) ──
GCP_PROJECT_ID=gen-lang-client-0920560496
GCP_REGION=us-central1

# ── Cloudflare (Edge) ──
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token

# ── LLM Providers (3-tier failover: Gemini → Azure → Workers AI) ──
GEMINI_API_KEY=your-gemini-key
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key

# ── Embeddings (HuggingFace 3-token round-robin, 384D) ──
HF_TOKEN_1=your-hf-token-1
HF_TOKEN_2=your-hf-token-2
HF_TOKEN_3=your-hf-token-3

# ── Heady Internal ──
HEADY_API_KEY=your-heady-api-key
HEADY_MANAGER_URL=https://heady-manager-bf4q4zywhq-uc.a.run.app
HEADY_VAULT_API_KEY=your-vault-api-key

# ── Stripe Billing (Per-Thought Metered) ──
STRIPE_SECRET_KEY=sk_live_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ── Mercury Treasury ──
MERCURY_API_TOKEN=your-mercury-token
MERCURY_ACCOUNT_ID=your-account-id

# ── Observability ──
SENTRY_DSN=https://your-dsn@sentry.io/project-id

# ── Security ──
JWT_SECRET=your-jwt-secret-min-32-chars
VAULT_ENCRYPTION_KEY=your-256-bit-hex-key

# ── SMTP (Notifications) ──
HEADY_SMTP_SERVER=smtp.gmail.com
HEADY_SMTP_PORT=587
HEADY_SMTP_USER=your-email@gmail.com
HEADY_SMTP_PASSWORD=your-app-password
HEADY_FROM_EMAIL=heady@headyconnection.org
HEADY_TO_EMAIL=eric@headyconnection.org
