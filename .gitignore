# === Dependencies ===
node_modules/
venv/
.venv/
env/
__pycache__/
*.pyc
*.py[cod]
*.pyo
*.pyd
*.egg-info/

# === Build Output ===
dist/
build/
.next/
**/build/
**/out/
*.js.map
*.css.map

# === Secrets & Credentials (CRITICAL — never commit) ===
.env
.env.local
.env.production
.env.staging
.env.hybrid
.heady_secrets
.heady/memory.db
.heady/*.db
*.db
.heady/.heady/
*.pem
*.key
*.p12
*.pfx

# === Logs ===
*.log
logs/
audit_logs.jsonl
.heady_deploy_log.jsonl
*.jsonl

# === Testing & Cache ===
.pytest_cache/
.ipynb_checkpoints/
coverage/
.nyc_output/
pipeline-output/
.heady_cache/

# === IDE & System ===
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# === Heady Artifacts ===
heady-manifest.json
HeadyAcademy/Content_Forge/Visualizations/

# === Large Binaries (use GitHub Releases) ===
*.zip
*.tar.gz
*.exe
*.msi
*.dmg
AndroidSDK/system-images/**/*.img

# === Deploy packages (temp build artifacts) ===
deploy-package-*/
offline-packages/

# === Standalone repos (separate git projects) ===
windsurf-next/

# === Personal notebooks (experimental, not tracked) ===
notebooks/personal/*
!notebooks/personal/.gitkeep

# === Runtime artifacts ===
*.pid
*.bak

# === Local Netlify folder ===
.netlify

# === Data (raw and external, avoid huge files in git) ===
data/raw/
data/external/
