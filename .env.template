# ════════════════════════════════════════════════════════════════════
# HEADY SYSTEMS :: ENVIRONMENT TEMPLATE
# ════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# Variables marked [REQUIRED] must be set for the system to boot.
# Variables marked [OPTIONAL] have defaults or are feature-gated.
#
# φ = 1.618033988749895 | ψ = 0.618033988749895
# ════════════════════════════════════════════════════════════════════

# ── Core Server ──
PORT=3300                                              # [REQUIRED] Main heady-manager port
NODE_ENV=production                                    # [REQUIRED] production | development
HEADY_ADMIN_SCRIPT=src/heady_project/heady_conductor.py
HEADY_PYTHON_BIN=python

# ── LLM Providers (Canonical Fallback Chain) ──
# Order: Gemini → Azure GPT → Workers AI → Anthropic → OpenAI → Groq
# See: src/llm-fallback-chain.js for the single source of truth
GOOGLE_AI_API_KEY=                                     # [REQUIRED] Gemini Flash-Lite (primary)
AZURE_OPENAI_API_KEY=                                  # [OPTIONAL] Azure GPT-4o-mini (secondary)
AZURE_OPENAI_ENDPOINT=                                 # [OPTIONAL] Azure endpoint URL
WORKERS_AI_TOKEN=                                      # [OPTIONAL] Cloudflare Workers AI (tertiary)
CF_AI_GATEWAY_URL=                                     # [OPTIONAL] Cloudflare AI Gateway proxy + caching
ANTHROPIC_API_KEY=                                     # [OPTIONAL] Claude (fallback)
OPENAI_API_KEY=                                        # [OPTIONAL] GPT-4o (fallback)
GROQ_API_KEY=                                          # [OPTIONAL] Groq Llama (last resort)

# ── Embedding Providers (3-token round-robin) ──
HUGGINGFACE_TOKEN_1=                                   # [REQUIRED] Primary HF token
HUGGINGFACE_TOKEN_2=                                   # [OPTIONAL] Secondary HF token (round-robin)
HUGGINGFACE_TOKEN_3=                                   # [OPTIONAL] Tertiary HF token (round-robin)

# ── Database (Neon Postgres + pgvector HNSW) ──
NEON_DATABASE_URL=                                     # [REQUIRED] Neon connection string
DATABASE_URL=                                          # [REQUIRED] Same as NEON_DATABASE_URL (alias)

# ── Cache & Message Queue (Upstash) ──
UPSTASH_REDIS_REST_URL=                                # [REQUIRED] Upstash Redis REST URL
UPSTASH_REDIS_REST_TOKEN=                              # [REQUIRED] Upstash Redis REST token
QSTASH_TOKEN=                                          # [OPTIONAL] QStash durable task dispatch
QSTASH_CURRENT_SIGNING_KEY=                            # [OPTIONAL] QStash webhook verification
QSTASH_NEXT_SIGNING_KEY=                               # [OPTIONAL] QStash key rotation

# ── Observability ──
SENTRY_DSN=                                            # [REQUIRED] Sentry error tracking DSN
SENTRY_AUTH_TOKEN=                                     # [OPTIONAL] Sentry release tracking + source maps
SENTRY_ORG=headyconnection-inc                         # Sentry org slug
SENTRY_PROJECT=heady-manager                           # Sentry project slug

# ── Cloudflare ──
CLOUDFLARE_API_TOKEN=                                  # [REQUIRED] Cloudflare API token
CLOUDFLARE_ACCOUNT_ID=                                 # [REQUIRED] Cloudflare account ID
CLOUDFLARE_ZONE_ID=                                    # [OPTIONAL] Primary zone ID

# ── Google Cloud Platform ──
GCP_PROJECT_ID=gen-lang-client-0920560496              # [REQUIRED] GCP project ID
GCP_REGION=us-central1                                 # [REQUIRED] Standardized region (see ADR)
CLOUD_RUN_URL=                                         # [OPTIONAL] Cloud Run service URL

# ── GitHub ──
GITHUB_TOKEN=                                          # [REQUIRED] GitHub PAT (minimum scopes: repo, workflow)
GITHUB_ORG=HeadyMe                                     # GitHub org

# ── Authentication (Firebase) ──
FIREBASE_API_KEY=                                      # [REQUIRED] Firebase Web API key
FIREBASE_AUTH_DOMAIN=                                   # [REQUIRED] Firebase auth domain
FIREBASE_PROJECT_ID=                                    # [REQUIRED] Firebase project ID

# ── Payments (Stripe — canonical processor for v1) ──
STRIPE_SECRET_KEY=                                     # [REQUIRED] Stripe secret key
STRIPE_PUBLISHABLE_KEY=                                # [OPTIONAL] Stripe publishable key
STRIPE_WEBHOOK_SECRET=                                 # [REQUIRED] Stripe webhook signing secret
STRIPE_PRICE_DEVELOPER=                                # Developer tier: $29/mo
STRIPE_PRICE_TEAM=                                     # Team tier: $99/mo
STRIPE_PRICE_ENTERPRISE=                               # Enterprise tier: $499/mo
STRIPE_PRICE_API=                                      # API Access: $2,990/yr

# ── Ed25519 Trust Receipts ──
HEADY_SIGNATURE_KEY=                                   # [REQUIRED] Ed25519 private key for pipeline signing

# ── Domain URLs (5 active + redirects) ──
HEADY_SYSTEMS_URL=https://headysystems.com             # Corporate hub
HEADY_MCP_URL=https://headymcp.com                     # Developer MCP platform
HEADY_CONNECTION_URL=https://headyconnection.org       # 501(c)(3) nonprofit
HEADY_AI_URL=https://heady-ai.com                      # AI OS surface
HEADY_ME_URL=https://headyme.com                       # Universal onboarding

# ── GPU / Remote Compute (Optional) ──
REMOTE_GPU_URL=                                        # [OPTIONAL] Remote GPU endpoint
GPU_API_KEY=                                           # [OPTIONAL] GPU API key
COLAB_GPU_URL=                                         # [OPTIONAL] Google Colab GPU endpoint

# ── Feature Flags ──
ENABLE_EXPERIMENTAL_FEATURES=false
ENABLE_COHERENCE_ALERTING=true
COHERENCE_DRIFT_FLOOR=0.809                            # CSL MEDIUM threshold
MAX_BEE_TYPES=89                                       # fib(11)
MAX_SWARM_SIZE=34                                      # fib(9)
